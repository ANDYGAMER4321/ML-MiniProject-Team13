# Copy this file to ".env" to override defaults. No API keys are needed:
# all data comes from the ATP match CSV files in the data/ folder.

HOST=127.0.0.1
PORT=5000
# Set to 1 only while developing (debug mode shows stack traces in the browser).
FLASK_DEBUG=0

# Data-quality rules for predictions
MIN_PRIOR_MATCHES=5
MAX_RANK_AGE_DAYS=365
